# Copia este archivo a .env.local y completa los valores.
# Nada de lo que no empiece por NEXT_PUBLIC_ debe llegar al navegador.

# --- Proveedores de IA ---
# DEMO_MODE=true usa respuestas simuladas y no gasta creditos.
DEMO_MODE=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5.5
ANTHROPIC_MODEL=claude-opus-4-8
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=
# GEMINI_RETRY_COUNT=
# GEMINI_RETRY_DELAY_MS=

# --- Supabase (login, organizaciones, proyectos) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidad con proyectos que todavia muestran ANON KEY:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Orquestador de jobs (solo servidor) ---
SUPABASE_SECRET_KEY=
# Compatibilidad legacy:
# SUPABASE_SERVICE_ROLE_KEY=
# Token largo y aleatorio compartido entre la app y los workers.
VACODER_WORKER_TOKEN=
VACODER_BASE_URL=http://localhost:3000

# --- Cloud runtime en sandbox E2B (solo servidor) ---
E2B_API_KEY=
VACODER_CLOUD_PROVIDER=e2b
VACODER_SNAPSHOT_BUCKET=vacoder-workspaces
VACODER_MAX_SNAPSHOT_MB=100
VACODER_CLOUD_WORKER_POLL_MS=2500
# VACODER_E2B_TEMPLATE=

# --- Herramientas locales (/api/project/* y /api/supreme/*) ---
# Leen/escriben el disco del servidor y ejecutan comandos. En produccion
# quedan bloqueadas (403) salvo que se habiliten aqui, y siempre exigen sesion.
# No lo actives en un despliegue publico: para eso esta el cloud runtime.
VACODER_LOCAL_TOOLS_ENABLED=false

# Carpeta raiz (ruta absoluta) con los proyectos que VACoder puede modificar.
# Por defecto: C:\Users\martin\Desktop\VSC\APPS en Windows, ~/vacoder-apps en macOS/Linux.
# VACODER_APPS_ROOT=

# --- Facturacion con Stripe (solo servidor) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de precio (price_...) de cada plan de suscripcion mensual.
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=
