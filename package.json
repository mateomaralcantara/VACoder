{
  "name": "vacoder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "validate": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "worker:orchestrator": "node scripts/workers/run-orchestrator-worker.mjs",
    "worker:cloud": "node --env-file-if-exists=.env.local services/cloud-worker/worker.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "e2b": "^2.39.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "typescript": "5.7.2"
  },
  "engines": {
    "node": ">=22.9"
  }
}
